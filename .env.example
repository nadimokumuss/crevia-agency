# Vercel > Project Settings > Environment Variables
# The contact form only appears when both RESEND_API_KEY and CREVIA_CONTACT_FROM_EMAIL are configured.
# Verify your sending domain in Resend before enabling.
RESEND_API_KEY=
CREVIA_CONTACT_FROM_EMAIL=Crevia Agency <contact@YOUR_VERIFIED_DOMAIN>
# Base URL for sitemap, robots.txt and metadata
NEXT_PUBLIC_SITE_URL=https://crevia-agency.vercel.app
